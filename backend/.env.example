NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://youshorts:youshorts@localhost:5432/youshorts?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
# Local Docker: leave password empty, REDIS_TLS unset or false
# Upstash: Endpoint + Port + password from Connect → Redis; REDIS_TLS=true
REDIS_PASSWORD=
REDIS_TLS=false
SESSION_SECRET=replace-this-with-a-long-random-secret

OPENAI_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=youshorts

YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
WORK_DIR=./tmp
